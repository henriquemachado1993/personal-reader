generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["reader"]
}

model User {
  id                String               @id @default(uuid()) @db.Uuid
  email             String               @unique
  name              String?
  passwordHash      String?
  passwordChangedAt DateTime?
  issuedInvites     RegistrationInvite[]
  libraryRevision   LibraryRevision?
  libraryEntities   LibraryEntity[]
  syncOperations    SyncOperation[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  @@schema("reader")
}

model LibraryRevision {
  ownerId  String @id @db.Uuid
  owner    User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  revision Int    @default(0)
  @@schema("reader")
}

model SyncOperation {
  ownerId     String   @db.Uuid
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  operationId String   @db.Uuid
  revision    Int
  appliedAt   DateTime @default(now())
  @@id([ownerId, operationId])
  @@schema("reader")
}

model Installation {
  id        String   @id @default("owner")
  ownerId   String   @unique @db.Uuid
  createdAt DateTime @default(now())
  @@schema("reader")
}

model LoginAttempt {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())
  @@schema("reader")
}

model PasswordReset {
  tokenHash String @id
  userId String @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@schema("reader")
}

model LibraryEntity {
  ownerId String @db.Uuid
  kind String
  entityId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  revision Int
  documentId String?
  payload Json?
  deleted Boolean @default(false)
  updatedAt DateTime @updatedAt
  @@id([ownerId, kind, entityId])
  @@index([ownerId, revision])
  @@index([ownerId, documentId])
  @@schema("reader")
}

model StorageDeletion {
  key String @id
  ownerId String @db.Uuid
  notBefore DateTime
  @@schema("reader")
}

model RegistrationInvite {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  email     String
  issuerId  String   @db.Uuid
  issuer    User     @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  @@index([issuerId, createdAt])
  @@index([email])
  @@schema("reader")
}
